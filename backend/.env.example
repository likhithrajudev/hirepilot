# Local dev uses SQLite by default. For Postgres: postgresql+psycopg://user:pass@localhost:5432/hirepilot
DATABASE_URL=sqlite:///./data/app.db
SECRET_KEY=change-me
# Leave empty locally; set in production (the frontend asks for it in Settings).
APP_TOKEN=
# Optional fallback if you don't want to paste the key in the UI:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
CORS_ORIGINS=http://localhost:3000
